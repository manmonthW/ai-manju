{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-comic-drama/prompt-ir.schema.json",
  "title": "Provider-neutral Prompt IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "scene", "subjects", "actions", "camera", "constraints", "references", "output"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mode": {"enum": ["t2i", "i2i", "t2v", "i2v", "start_end_frame", "motion_transfer", "camera_trajectory"]},
    "scene": {"type": "object"},
    "subjects": {"type": "array", "items": {"type": "object"}},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "subject_id", "motion", "endpoint"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "subject_id": {"type": "string"},
          "motion": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1}
        }
      }
    },
    "camera": {"type": "object"},
    "audio": {"type": "object"},
    "style": {"type": "object"},
    "constraints": {"type": "object"},
    "references": {"type": "array", "items": {"type": "object"}},
    "output": {"type": "object"}
  }
}
